# Lumen — environment template. Copy to `.env` and fill real values for local dev.
# `.env` is gitignored; NEVER commit real secrets (see constitution: secrets stay
# out of the repo and out of the database). Production secrets come from a secrets
# manager at deploy time (spec 16), never from this file.
#
# Every variable the project will use as it grows is enumerated here and validated
# at API startup against the Zod schema in `packages/shared` (fail fast). Variables
# for not-yet-built features are documented now and may be left blank until then.

# --- App database (PostgreSQL) — local Docker from docker-compose.yml (spec 00) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lumen

# --- Client database stand-in (MySQL) — local Docker from docker-compose.yml ---
# NOTE: root here is ONLY for local provisioning/seeding. Spec 08 must create and
# use a dedicated SELECT-only MySQL user (mirroring the onboarding script) and must
# REJECT root / over-privileged credentials — never connect as root in the product.
MYSQL_URL=mysql://root:root@localhost:3306/lumen_client

# --- Secrets (local dev) ---
# 32-byte AES-256-GCM master key for encryption-at-rest (spec 02), base64-encoded.
# Generate: `openssl rand -base64 32`
SECRETS_ENCRYPTION_KEY=
# JWT signing secret for the httpOnly auth cookie (spec 05).
# Generate: `openssl rand -base64 48`
JWT_SECRET=

# --- Runtime ---
# API listen port and node environment (optional; sane defaults applied).
PORT=3001
NODE_ENV=development
# Public base URL of the SPA — used to build the email-verification link
# `{APP_URL}/verify-email?token=...` (spec 04). Defaults to the Vite dev server.
APP_URL=http://localhost:5173

# --- Frontend (apps/web, Vite) ---
# Base URL the SPA calls for the API (spec 06). Read by Vite as import.meta.env.
# Defaults to http://localhost:3001 in code if unset. The cross-origin cookie flow
# (SameSite=None) is finalized at deploy (spec 16).
VITE_API_URL=http://localhost:3001

# --- Deferred external services (spec 04 / 11 / 15) ---
# Leave BLANK locally: the build binds in-memory fakes and env-gates live
# integration tests to SKIP (recorded as LIVE-VERIFICATION-PENDING) when absent.
RESEND_API_KEY=
# Sender identity for transactional email (spec 04). Default is Resend's shared
# sandbox sender; a verified custom domain is a deploy-time (spec 16) DNS step.
RESEND_FROM_EMAIL=Lumen <onboarding@resend.dev>
ANTHROPIC_API_KEY=
SENTRY_DSN=
